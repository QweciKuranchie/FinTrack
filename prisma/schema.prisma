generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Household {
  id        String   @id @default(uuid())
  name      String
  createdBy String
  createdAt DateTime @default(now())

  members       HouseholdMember[]
  accounts      Account[]
  categories    Category[]
  liabilities   Liability[]
  assets        Asset[]
  subscriptions Subscription[]
  budgets       Budget[]
  snapshots     NetWorthSnapshot[]
  savingsGoals  SavingsGoal[]
  debtRecords   DebtRecord[]
  repairs       RepairTask[]
  needs         NeedItem[]
  promises      PromisePledge[]
  syncFeeds     SyncFeed[]
}

model HouseholdMember {
  id          String   @id @default(uuid())
  householdId String
  userId      String   // Supabase auth.users.id
  role        Role     @default(OWNER)
  joinedAt    DateTime @default(now())

  household Household @relation(fields: [householdId], references: [id])

  @@unique([householdId, userId])
}

enum Role {
  OWNER
  MEMBER
}

model UserProfile {
  id                String   @id // Supabase auth.users.id
  email             String   @unique
  name              String?
  username          String?
  avatarUrl         String?
  activeHouseholdId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Account {
  id             String      @id @default(uuid())
  householdId    String
  ownerId        String      // Supabase user id
  name           String
  type           AccountType
  currency       String      // ISO 4217, e.g. "GHS", "USD"
  currentBalance Decimal     @default(0)
  institution    String?
  isArchived     Boolean     @default(false)
  createdAt      DateTime    @default(now())

  household    Household     @relation(fields: [householdId], references: [id])
  transactions Transaction[]
  savingsGoals SavingsGoal[]
}

enum AccountType {
  BANK
  CHECKING
  SAVINGS
  MOBILE_MONEY
  TELECEL_CASH
  CASH
  INVESTMENT
  OTHER
}

model Category {
  id          String       @id @default(uuid())
  householdId String?      // null = system default category
  name        String
  type        CategoryType
  icon        String?
  color       String?
  parentId    String?

  household    Household?    @relation(fields: [householdId], references: [id])
  transactions Transaction[]
  budgets      Budget[]
}

enum CategoryType {
  INCOME
  EXPENSE
}

model Transaction {
  id                String    @id @default(uuid())
  accountId         String
  categoryId        String?
  amount            Decimal
  taxRate           Decimal?  @default(0)
  taxAmount         Decimal?  @default(0)
  currency          String
  type              TxnType
  description       String?
  date              DateTime
  source            TxnSource @default(MANUAL)
  transferAccountId String?
  createdAt         DateTime  @default(now())

  account  Account   @relation(fields: [accountId], references: [id])
  category Category? @relation(fields: [categoryId], references: [id])

  @@index([accountId, date])
  @@index([categoryId, date])
}

enum TxnType {
  INCOME
  EXPENSE
  TRANSFER
}

enum TxnSource {
  MANUAL
  CSV_IMPORT
}

model Liability {
  id             String          @id @default(uuid())
  householdId    String
  name           String
  counterparty   String?
  isReceivable   Boolean         @default(false)
  type           LiabilityType   @default(OTHER)
  principal      Decimal
  currentBalance Decimal
  interestRate   Decimal?
  interestPeriod InterestPeriod? @default(ANNUAL)
  lateFee        Decimal?
  minimumPayment Decimal?
  dueDate        DateTime?
  currency       String          @default("GHS")
  notes          String?
  createdAt      DateTime        @default(now())

  household Household @relation(fields: [householdId], references: [id])
}

enum InterestPeriod {
  DAILY
  WEEKLY
  MONTHLY
  ANNUAL
}

enum LiabilityType {
  LOAN
  CREDIT_CARD
  MORTGAGE
  OTHER
}

model DebtRecord {
  id             String    @id @default(uuid())
  householdId    String
  title          String
  counterparty   String
  isReceivable   Boolean   @default(false)
  amount         Decimal
  currentBalance Decimal
  dueDate        DateTime?
  currency       String    @default("GHS")
  notes          String?
  createdAt      DateTime  @default(now())

  household Household @relation(fields: [householdId], references: [id])
}

model Asset {
  id            String    @id @default(uuid())
  householdId   String
  name          String
  symbol        String?
  type          AssetType
  quantity      Decimal?
  purchasePrice Decimal?
  currentValue  Decimal
  currency      String    @default("GHS")
  notes         String?
  lastValuedAt  DateTime  @default(now())

  household Household @relation(fields: [householdId], references: [id])
}

enum AssetType {
  PROPERTY
  VEHICLE
  INVESTMENT
  OTHER
}

model Investment {
  id           String   @id @default(uuid())
  householdId  String
  accountId    String?
  symbol       String
  name         String
  quantity     Decimal
  avgCost      Decimal
  currentPrice Decimal
  currency     String
  assetClass   String?  // "stock", "crypto", "etf", etc.
  updatedAt    DateTime @updatedAt
}

model Subscription {
  id                 String       @id @default(uuid())
  householdId        String
  name               String
  amount             Decimal
  currency           String
  billingCycle       BillingCycle
  nextRenewalDate    DateTime
  categoryId         String?
  isActive           Boolean      @default(true)
  reminderDaysBefore Int          @default(3)
  createdAt          DateTime     @default(now())

  household Household @relation(fields: [householdId], references: [id])
}

enum BillingCycle {
  WEEKLY
  MONTHLY
  YEARLY
}

model Budget {
  id          String   @id @default(uuid())
  householdId String
  categoryId  String
  amount      Decimal
  currency    String   @default("GHS")
  periodStart DateTime // first day of month this budget applies to

  household Household @relation(fields: [householdId], references: [id])
  category  Category  @relation(fields: [categoryId], references: [id])

  @@unique([householdId, categoryId, periodStart])
}

model NetWorthSnapshot {
  id               String   @id @default(uuid())
  householdId      String
  date             DateTime
  totalAssets      Decimal
  totalLiabilities Decimal
  netWorth         Decimal
  currency         String   @default("GHS")

  household Household @relation(fields: [householdId], references: [id])

  @@unique([householdId, date])
}

model FxRate {
  id             String   @id @default(uuid())
  baseCurrency   String
  targetCurrency String
  rate           Decimal
  fetchedAt      DateTime @default(now())

  @@unique([baseCurrency, targetCurrency])
}

model CsvImportLog {
  id        String   @id @default(uuid())
  accountId String
  filename  String
  rowCount  Int
  status    String   // "success", "partial", "failed"
  createdAt DateTime @default(now())
}

model SavingsGoal {
  id            String    @id @default(uuid())
  householdId   String
  accountId     String?
  name          String
  targetAmount  Decimal
  currentAmount Decimal   @default(0)
  deadline      DateTime?
  currency      String    @default("GHS")
  createdAt     DateTime  @default(now())

  household Household @relation(fields: [householdId], references: [id])
  account   Account?  @relation(fields: [accountId], references: [id])
}

model RepairTask {
  id            String   @id @default(uuid())
  householdId   String
  type          String   @default("REPAIR") // REPAIR, REPLACEMENT
  item          String
  category      String
  estimatedCost Decimal  @default(0)
  status        String   @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED
  urgency       String   @default("MEDIUM")  // HIGH, MEDIUM, LOW
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  household Household @relation(fields: [householdId], references: [id])
}

model NeedItem {
  id            String   @id @default(uuid())
  householdId   String
  title         String
  category      String   @default("MUST_HAVE") // MUST_HAVE, HIGH_PRIORITY, MEDIUM, WANT
  estimatedCost Decimal  @default(0)
  isFulfilled   Boolean  @default(false)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  household Household @relation(fields: [householdId], references: [id])
}

model PromisePledge {
  id          String    @id @default(uuid())
  householdId String
  type        String    @default("PROMISED_BY_ME") // PROMISED_BY_ME, PROMISED_TO_ME
  recipient   String
  purpose     String
  amount      Decimal   @default(0)
  dueDate     DateTime?
  status      String    @default("PENDING") // PENDING, PARTIAL, FULFILLED
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  household Household @relation(fields: [householdId], references: [id])
}

model SyncFeed {
  id          String   @id @default(uuid())
  householdId String
  source      String
  type        String   // INCOME, EXPENSE, TRANSFER
  amount      Decimal  @default(0)
  description String
  accountName String
  status      String   @default("SYNCED") // PARSED, SYNCED
  createdAt   DateTime @default(now())

  household Household @relation(fields: [householdId], references: [id])
}
